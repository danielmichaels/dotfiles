#!/bin/bash
send_link() {
  local url="$1"
  local title="$2"
  local description="${3:-no description}"

  if [[ -z "$url" || -z "$title" ]]; then
      echo "Both title and url must be provided"
      exit 1
  fi

  local key_file_path="$HOME/.config/me/transporter/key"
  if [[ ! -f "$key_file_path" ]]; then
      echo "API Key file not found at $key_file_path"
      exit 1
  fi

  local key
  key=$(head -n 1 "$key_file_path" | tr -d '\n')

  local payload
  payload=$(jq -n --arg url "$url" --arg title "$title" --arg description "$description" \
      '{description: $description, title: $title, tag_names: ["sendlink"], url: $url}')

  local response
  response=$(curl -s -X POST 'https://transporter.danielms.site/link' \
      -H "X-API-KEY: $key" \
      -H "Content-Type: application/json" \
      -d "$payload")
      # Print formatted JSON response
          echo "$response" | jq .
}

  main() {
      if [[ $# -lt 2 ]]; then
          echo "Usage: $0 <url> <title> [-d <description>]"
          exit 1
  fi

      local url="$1"
      shift
      local title="$1"
      shift
      local description="no description"

      while getopts "d:" opt; do
          case $opt in
              d)
                  description="$OPTARG"
                  ;;
              *)
                  echo "Invalid option: -$opt"
                  exit 1
                  ;;
    esac
  done

      send_link "$url" "$title" "$description"
}

main "$@"
