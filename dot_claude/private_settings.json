{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  },
  "permissions": {
    "allow": [
      "View",
      "WebFetch(domain:docs.synadia.com)",
      "WebFetch(domain:natsbyexample.com)",
      "WebFetch(domain:nats.io)",
      "WebFetch(domain:docs.nats.io)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:huma.rocks)",
      "WebFetch(domain:templui.io)",
      "WebFetch(domain:docs.rs)",
      "WebFetch(domain:tauri.app)",
      "WebFetch(domain:riverqueue.com)",
      "WebFetch(domain:go.pkg.dev)",
      "WebFetch(domain:deepwiki.com)",
      "WebFetch(domain:pocketbase.io)",
      "WebFetch(domain:golangci-lint.run)",
      "WebFetch(domain:docs.dokploy.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebSearch",
      "Bash(templui add:*)",
      "Bash(templ generate:*)",
      "Bash(go list:*)",
      "Bash(go build:*)",
      "Bash(go doc:*)",
      "Bash(go test:*)",
      "Bash(go run:*)",
      "Bash(go version:*)",
      "Bash(go env:*)",
      "Bash(go vet:*)",
      "Bash(oapi-codegen:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(ls:*)",
      "Bash(/bin/ls:*)",
      "Bash(echo:*)",
      "Bash(cat:*)",
      "Bash(/bin/cat:*)",
      "Bash(grep:*)",
      "Bash(task:*)",
      "Bash(docker build:*)",
      "Bash(docker run:*)",
      "Bash(xargs ls:*)",
      "Bash(lsof:*)",
      "Bash(git grep:*)",
      "Bash(git -C:*)",
      "Bash(awk:*)",
      "Bash(nats:*)",
      "Bash(tree:*)",
      "Bash(wc:*)",
      "Bash(jq:*)",
      "Bash(cargo check:*)",
      "Bash(csearch:*)",
      "Bash(gh pr:*)",
      "Bash(gh issue:*)",
      "Bash(gh list:*)",
      "Bash(gh status:*)",
      "Bash(gh diff:*)",
      "Bash(gh checks:*)",
      "Bash(gh api:*)",
      "Read(~/code/github/*)",
      "Read(~/.claude/plans/*)",
      "Read(~/.config/worktrunk/config.toml)",
      "Read(~/.cache/checkouts/*)",
      "mcp__deepwiki__read_wiki_structure",
      "mcp__deepwiki__read_wiki_contents",
      "mcp__deepwiki__ask_question",
      "mcp__sequential-thinking__sequentialthinking",
      "mcp__nats-mcp__list_repos",
      "mcp__nats-mcp__search_code",
      "mcp__nats-mcp__get_adr",
      "mcp__nats-mcp__list_files",
      "mcp__nats-mcp__read_file",
      "mcp__nats-mcp__find_symbol",
      "mcp__nats-mcp__show_type"
    ]
  },
  "skillOverrides": {
    "embedded-postgres": "off",
    "find-skills": "off",
    "nats-server-config": "off",
    "wireframe": "off",
    "plan-task": "off",
    "research-task": "off",
    "implement-task": "off"
  },
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Glass.aiff"
          }
        ]
      }
    ],
    "PreToolUse": [],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/danielmichaels/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash -c '\"/opt/homebrew/bin/bun\" \"$(ls -td ~/.claude/plugins/cache/claude-hud/claude-hud/*/ 2>/dev/null | head -1)src/index.ts\"'"
  },
  "enabledPlugins": {
    "clangd-lsp@claude-plugins-official": false,
    "claude-hud@claude-hud": true,
    "code-simplifier@claude-plugins-official": true,
    "codex@openai-codex": false,
    "explanatory-output-style@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "learning-output-style@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "superpowers@claude-plugins-official": false,
    "expo@claude-plugins-official": false,
    "context7@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "claude-hud": {
      "source": {
        "source": "github",
        "repo": "jarrodwatts/claude-hud"
      }
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    },
    "mattpocock": {
      "source": {
        "source": "github",
        "repo": "mattpocock/skills"
      }
    }
  },
  "effortLevel": "xhigh",
  "tui": "fullscreen",
  "editorMode": "vim",
  "skipAutoPermissionPrompt": true,
  "feedbackSurveyState": {
    "lastShownTime": 1754046408392
  },
  "skipDangerousModePermissionPrompt": true
}
