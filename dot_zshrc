export EDITOR=nvim
export VISUAL=nvim
export REPOS="$HOME/code"
export GHREPOS="$REPOS/github"
export ZETDIR="$GHREPOS/personal/zet"
export SSH_AUTH_SOCK="${XDG_RUNTIME_DIR}/ssh-agent.socket"
export GPG_TTY=$(tty)
export SCRIPTS="${HOME}/.local/share/chezmoi/scripts"
#######################################################
#                  GO Settings                      #
#######################################################
# Setup private repos by defining the user, in this case, me.
export GOPRIVATE="github.com/$GITUSER/*,gitlab.com/$GITUSER/*"
#export GOPROXY=https://proxy.golang.org,direct
export GOPROXY=direct
#######################################################
#                  General Alias                      #
#######################################################
alias synadia="cd ~/code/github/synadia/"
alias ze="zellij -l ~/setup/synadia.kdl"
alias vi="/usr/bin/vim"
alias vim="nvim"
alias lg="lazygit"
alias ark="arkade"
alias pm="pnpm"
alias chez="chezmoi"
alias setup="cd $HOME/setup"
alias faas="faas-cli"
alias zs="chezmoi edit ~/.zshrc"
alias vimrc="chezmoi edit ~/.vimrc"
alias inet="ip -br a"
alias kurl="/usr/bin/curl"
if command -v curlie >/dev/null 2>&1; then
  alias curl="noglob curlie"
fi
if command -v restish >/dev/null 2>&1; then
  alias restish="noglob restish"
fi
if command -v flyctl >/dev/null 2>&1; then
  alias fly="flyctl"
fi
if command -v eza >/dev/null 2>&1; then
  alias ls="eza"
  alias el="eza --oneline"
  alias ee="eza --header --long"
  alias la="eza --header --long --all"
fi
if command -v podman >/dev/null 2>&1; then
  alias docker="podman"
  alias doc="podman compose"
else
  alias doc='docker compose'
fi
alias ssh="ssh -v"
alias k="kubectl"
alias mk="minikube"
alias chmox="chmod +x "
#
#######################################################
#                  Git Alias                          #
#######################################################
#
alias gs="git status"
alias gf="git fetch"
alias gl="git log --graph --oneline --decorate --all"
alias gc="git commit"
alias gac="git add . && git commit" # drop into EDITOR to confirm 'git add .'
alias gp="git push -v"
alias checkout="git checkout"
#
######################################################
#                Custom Functions                    #
######################################################
#
gi() { curl -sLw n https://www.gitignore.io/api/$@ ;}
#
# cd and ls automatically
function cd {
  builtin cd "$@" && ls -F; 
}
#######################################################
#                 VIM bindings                        #
#######################################################
#
set -o vi
bindkey -v
bindkey -M viins 'jk' vi-cmd-mode
bindkey '^R' history-incremental-search-backward
bindkey '^ ' autosuggest-accept
# ESC v; opens $EDITOR with CLI input
# autoload -U edit-command-line
# zle -N edit-command-line
# bindkey -M vicmd v edit-command-line
#######################################################
#                 VIRTUAL ENVIRONMENTS                #
#######################################################
#
# move to uv
# VIRTUALENVWRAPPER_PYTHON='/usr/bin/python3'
# source $HOME/.local/bin/virtualenvwrapper.sh  #work around --user install
# export WORKON_HOME=$HOME/.virtualenvs
#######################################################
#                 COMPLETIONS                         #
#######################################################
command -v gh >/dev/null 2>&1 && source <(gh completion --shell zsh) || echo "github-cli not installed, cannot source completions"
command -v faas-cli >/dev/null 2>&1 && source <(faas-cli completion --shell zsh)
command -v arkade >/dev/null 2>&1 && source <(arkade completion zsh)
command -v flux >/dev/null 2>&1 && source <(flux completion zsh)
autoload -U compinit && compinit -i
#######################################################
#                 START UP                            #
#######################################################
command -v thefuck >/dev/null 2>&1 && eval $(thefuck --alias)
if command -v starship >/dev/null 2>&1; then 
eval "$(starship init zsh)"
fi
if command -v atuin >/dev/null 2>&1; then 
  eval "$(atuin init zsh --disable-up-arrow)"
fi

export OPENAI_API_KEY="$(head -1 "$HOME/.config/gpt/token")"
export ANTHROPIC_API_KEY="$(head -1 "$HOME/.config/gpt/claude")"

 if command -v mise >/dev/null 2>&1; then
   eval "$(mise activate zsh)"
 fi
 if command -v zoxide >/dev/null 2>&1; then
   eval "$(zoxide init zsh)"
 fi
