// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "context": "Workspace",
    "bindings": {
      "shift shift": "file_finder::Toggle",
      "cmd-p": [
        "task::Spawn",
        { "task_name": "grep_file", "reveal_target": "center" }
      ],
      "cmd-f": [
        "task::Spawn",
        { "task_name": "grep_text", "reveal_target": "center" }
      ],
      "shift f w": [
        "task::Spawn",
        { "task_name": "grep_text", "reveal_target": "center" }
      ],
      "shift f f": [
        "task::Spawn",
        { "task_name": "grep_file", "reveal_target": "center" }
      ]
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "cmd-f": [
        "task::Spawn",
        { "task_name": "grep_text", "reveal_target": "center" }
      ],
      "shift f w": [
        "task::Spawn",
        { "task_name": "grep_text", "reveal_target": "center" }
      ],
      "shift f f": [
        "task::Spawn",
        { "task_name": "grep_file", "reveal_target": "center" }
      ],
      "shift r r": ["task::Spawn", { "task_name": "zig_run" }],
      "shift r d": ["task::Spawn", { "task_name": "zig_build" }]
    }
  },
  {
    "context": "Editor && vim_mode == insert && !menu",
    "bindings": {
      "j k": "vim::SwitchToNormalMode"
    }
  }
]
