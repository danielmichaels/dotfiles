// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "context": "Workspace",
    "bindings": {
      "alt-j": "terminal_panel::ToggleFocus",
      "shift shift": "file_finder::Toggle",
      "cmd-p": [
        "task::Spawn",
        { "task_name": "grep_file", "reveal_target": "center" }
      ],
      "cmd-f": [
        "task::Spawn",
        { "task_name": "grep_text", "reveal_target": "center" }
      ],
      "shift f w": [
        "task::Spawn",
        { "task_name": "grep_text", "reveal_target": "center" }
      ],
      "shift f f": [
        "task::Spawn",
        { "task_name": "grep_file", "reveal_target": "center" }
      ],

      // external agents (shift = leader)
      "shift c c c": "agent::ToggleFocus",
      "shift c x": "agent::ToggleFocus",
      "shift c s": "agent::AddSelectionToThread",

      // lazygit panel (opens in new terminal like the `tv` tasks)
      "shift l g": ["task::Spawn", { "task_name": "lazygit" }]
    }
  },
  {
    "context": "Editor && vim_mode == normal",
    "bindings": {
      // splits
      "space shift-v": "pane::SplitRight",
      "space shift-h": "pane::SplitDown",
      "space shift-u": "pane::CloseAllItems",
      "space q": "pane::CloseActiveItem",
      "space w v": "pane::SplitRight",
      "space w s": "pane::SplitDown",
      "space w u": "pane::CloseAllItems",

      // pane navigation (Ctrl+HJKL)
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-l": "workspace::ActivatePaneRight",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-j": "workspace::ActivatePaneDown",

      // file tree & tool windows
      "space e": "workspace::ToggleLeftDock",
      "space t": "terminal_panel::ToggleFocus",
      "space ;": "workspace::CloseAllDocks"
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "cmd-f": [
        "task::Spawn",
        { "task_name": "grep_text", "reveal_target": "center" }
      ],
      "shift f w": [
        "task::Spawn",
        { "task_name": "grep_text", "reveal_target": "center" }
      ],
      "shift f f": [
        "task::Spawn",
        { "task_name": "grep_file", "reveal_target": "center" }
      ]
    }
  },
  {
    "context": "Editor && extension == zig",
    "bindings": {
      "shift r r": ["task::Spawn", { "task_name": "zig_run" }],
      "shift r d": ["task::Spawn", { "task_name": "zig_build" }]
    }
  },
  {
    "context": "Editor && vim_mode == insert && !menu",
    "bindings": {
      "j k": "vim::SwitchToNormalMode"
    }
  }
]
