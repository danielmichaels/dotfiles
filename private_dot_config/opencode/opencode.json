{
  "$schema": "https://opencode.ai/config.json",
  "disabled_providers": ["opencode"],
  "autoupdate": true,
  "lsp": true,
  "instructions": [
    "~/.claude/CLAUDE.md",
    "~/.claude/skills/tdd/SKILL.md",
    "~/.claude/skills/rita-event-sourcing/SKILL.md",
    "~/.claude/skills/create-plan/SKILL.md",
    "~/.claude/skills/grill-me/SKILL.md",
    "~/.claude/skills/handoff/SKILL.md",
    "~/code/github/personal/cskills/go/skills/datastar/SKILL.md",
    "~/code/github/personal/cskills/go/skills/huma/SKILL.md",
    "AGENTS.md",
    "CLAUDE.md"
  ],
  "provider": {
    "ollama": {
      "name": "Ollama",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1"
      },
      "models": {
        "gemma4:e4b": {
          "name": "Gemma 4 E4B"
        },
        "gemma4:26b-a4b-it-q8_0": {
          "name": "Gemma 4 26B IT Q8"
        },
        "qwen3.5:latest": {
          "name": "Qwen 3.5"
        }
      }
    },
    "headroom": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Headroom Proxy",
      "options": {
        "baseURL": "http://127.0.0.1:8787/v1"
      }
    }
  },
  "model": "opencode-go/glm-5.2",
  "default_agent": "build",
  "permission": {
    "doom_loop": "ask",
    "external_directory": {
      "*": "ask",
      "~/code/**": "allow",
      "/tmp/**": "allow",
      "/private/tmp/**": "allow",
      "~/.claude/**": "allow"
    },
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "todowrite": "allow",
    "question": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "skill": "allow",
    "task": "allow",
    "bash": {
      "*": "ask",
      "git status *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git branch *": "allow",
      "git show *": "allow",
      "git stash list *": "allow",
      "git remote *": "allow",
      "git fetch *": "allow",
      "git add *": "allow",
      "git commit *": "allow",
      "git checkout *": "allow",
      "git switch *": "allow",
      "git merge *": "allow",
      "git clone *": "allow",
      "git pull *": "allow",
      "git init *": "allow",
      "git worktree *": "allow",
      "git rebase *": "allow",
      "git push *": "allow",
      "git reset --soft *": "allow",
      "git reset --hard *": "deny",
      "git push --force *": "deny",
      "worktrunk *": "allow",
      "ls *": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "find *": "allow",
      "rg *": "allow",
      "grep *": "allow",
      "sort *": "allow",
      "uniq *": "allow",
      "wc *": "allow",
      "cut *": "allow",
      "awk *": "allow",
      "sed *": "allow",
      "tr *": "allow",
      "xargs *": "allow",
      "tee *": "allow",
      "diff *": "allow",
      "comm *": "allow",
      "paste *": "allow",
      "column *": "allow",
      "which *": "allow",
      "type *": "allow",
      "file *": "allow",
      "stat *": "allow",
      "du *": "allow",
      "df *": "allow",
      "env": "allow",
      "printenv *": "allow",
      "uname *": "allow",
      "hostname": "allow",
      "whoami": "allow",
      "id": "allow",
      "date *": "allow",
      "pwd": "allow",
      "echo *": "allow",
      "printf *": "allow",
      "mkdir *": "allow",
      "cp *": "allow",
      "mv *": "allow",
      "rm *": "ask",
      "rm -rf *": "deny",
      "pnpm *": "allow",
      "npm *": "allow",
      "npx *": "allow",
      "node *": "allow",
      "bun *": "allow",
      "gh pr list *": "allow",
      "gh pr view *": "allow",
      "gh pr diff *": "allow",
      "gh pr checks *": "allow",
      "gh pr status *": "allow",
      "gh issue list *": "allow",
      "gh issue view *": "allow",
      "gh issue status *": "allow",
      "gh repo view *": "allow",
      "gh repo clone *": "allow",
      "gh api *": "allow",
      "gh search *": "allow",
      "gh status": "allow",
      "gh status *": "allow",
      "gh run list *": "allow",
      "gh run view *": "allow",
      "gh run watch *": "allow",
      "gh workflow list *": "allow",
      "gh workflow view *": "allow",
      "gh cache list *": "allow",
      "gh release list *": "allow",
      "gh release view *": "allow",
      "gh gist list *": "allow",
      "gh gist view *": "allow",
      "gh label list *": "allow",
      "gh ruleset list *": "allow",
      "gh ruleset view *": "allow",
      "gh pr create *": "ask",
      "gh pr merge *": "ask",
      "gh pr close *": "ask",
      "gh issue create *": "ask",
      "gh issue close *": "ask",
      "gh run cancel *": "ask",
      "gh run rerun *": "ask",
      "gh release create *": "ask",
      "gh release delete *": "deny",
      "lsof *": "allow",
      "kill *": "ask",
      "wrangler *": "allow",
      "jq *": "allow",
      "bat *": "allow",
      "fd *": "allow",
      "fzf *": "allow",
      "delta *": "allow",
      "htop *": "allow",
      "tree *": "allow",
      "curl *": "allow",
      "wget *": "allow",
      "go *": "allow",
      "rustc *": "allow",
      "cargo *": "allow",
      "python *": "allow",
      "python3 *": "allow",
      "pip *": "allow",
      "pip3 *": "allow",
      "pipx *": "allow",
      "uv *": "allow",
      "uvx *": "allow",
      "ruff *": "allow",
      "ruby *": "allow",
      "make *": "allow",
      "cmake *": "allow",
      "shellcheck *": "allow",
      "jj *": "allow",
      "mkcert *": "allow",
      "age *": "allow",
      "stow *": "allow",
      "chezmoi *": "ask",
      "tmux *": "allow",
      "nvim *": "allow",
      "zoxide *": "allow",
      "atuin *": "allow",
      "asciinema *": "allow",
      "agg *": "allow",
      "gifski *": "allow",
      "ffmpeg *": "allow",
      "websocat *": "allow",
      "nmap *": "ask",
      "cloudflared *": "allow",
      "pscale *": "allow",
      "yarn *": "allow",
      "wrk *": "allow",
      "try *": "allow",
      "task *": "allow",
      "docker *": "allow",
      "docker-compose *": "allow",
      "docker compose *": "allow",
      "brew *": "allow",
      "open *": "allow",
      "pbcopy": "allow",
      "pbpaste": "allow",
      "source *": "allow",
      "glab mr list *": "allow",
      "glab mr view *": "allow",
      "glab mr diff *": "allow",
      "glab mr checkout *": "allow",
      "glab issue list *": "allow",
      "glab issue view *": "allow",
      "glab repo view *": "allow",
      "glab auth *": "allow",
      "glab mr create *": "allow",
      "glab mr merge *": "ask",
      "glab mr close *": "ask",
      "glab issue create *": "allow",
      "glab issue close *": "ask"
    }
  },
  "agent": {
    "build": {
      "mode": "primary",
      "model": "opencode-go/minimax-m2.7"
    },
    "loop": {
      "mode": "primary",
      "model": "opencode-go/glm-5.2"
    },
    "local": {
      "mode": "primary",
      "description": "Primary local agent Gemma 4",
      "model": "ollama/gemma4:e4b"
    },
    "plan": {
      "mode": "primary",
      "model": "opencode-go/kimi-k2.6"
    }
  },
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest"],
      "enabled": false
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest"],
      "enabled": false
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app"
    }
  }
}
