{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "instructions": [
    "~/.claude/CLAUDE.md",
    "~/.claude/skills/tdd/SKILL.md"
  ],
  "provider": {
    "ollama": {
      "name": "Ollama",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1"
      },
      "models": {
        "gemma4:e4b": {
          "name": "Gemma 4 E4B"
        },
        "gemma4:26b-a4b-it-q8_0": {
          "name": "Gemma 4 26B IT Q8"
        },
        "qwen3.5:latest": {
          "name": "Qwen 3.5"
        }
      }
    }
  },
  "model": "opencode/glm-5.2",
  "default_agent": "build",
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "todowrite": "allow",
    "question": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "skill": "allow",
    "task": "allow",
    "bash": {
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "sed *": "allow",
      "cd *": "allow",
      "go *": "allow",
      "python *": "allow",
      "python3 *": "allow",
      "rustc *": "allow",
      "uvx *": "allow",
      "rg *": "allow",
      "gh issue *": "allow",
      "gh issue view *": "allow",
      "gh pr *": "ask",
      "gh pr view *": "allow",
      "gh pr diff *": "allow",
      "gh pr check *": "allow",
      "rtk *": "allow",
      "pnpm *": "allow",
      "npm *": "allow",
      "npx *": "allow",
      "make *": "allow",
      "gmfmt *": "allow",
      "wc *": "allow",
      "git *": "allow",
      "git commit *": "ask",
      "git push *": "deny",
      "*": "ask"
    }
  },
  "agent": {
    "build": {
      "mode": "primary",
      "model": "opencode/minimax-m2.7",
      "permission": {
        "bash": {
          "git commit *": "ask",
          "git push *": "deny",
          "gh pr *": "ask"
        }
      }
    },
    "loop": {
      "mode": "primary",
      "model": "opencode/glm-5.2",
      "permission": {
        "bash": {
          "git commit *": "ask",
          "git push *": "deny",
          "gh pr *": "ask"
        }
      }
    },
    "local": {
      "mode": "primary",
      "description": "Primary local agent Gemma 4",
      "model": "ollama/gemma4:26b-a4b-it-q8_0"
    },
    "plan": {
      "mode": "primary",
      "model": "opencode/kimi-k2.6",
      "permission": {
        "edit": "ask",
        "bash": {
          "git commit *": "ask",
          "git push *": "deny",
          "gh pr *": "ask"
        }
      }
    }
  },
  "mcp": {
    "searchcode": {
      "type": "remote",
      "url": "https://api.searchcode.com/v1/mcp"
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app"
    }
  }
}
